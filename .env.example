# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real secrets.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---
# Project Settings > Data API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings > API Keys. Bypasses RLS. Server-side only, never exposed to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings > Database > Connection string (URI). Only needed to run
# migrations (supabase db push / one-off migration scripts), not by the app itself.
SUPABASE_DB_URL=

# --- Stripe (Phase 1) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FREE=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# --- Claude API (Phase 3) ---
ANTHROPIC_API_KEY=

# --- Embeddings provider (Phase 2) ---
# Claude has no native embeddings endpoint, so RAG uses OpenAI text-embedding-3-small
# (1536 dimensions, matching knowledge_chunks.embedding). See CHANGELOG.md.
OPENAI_API_KEY=

# --- Google Calendar OAuth (Phase 4) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Symmetric key used to encrypt google_refresh_token before it is stored.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# --- Transactional email (Phase 1) ---
RESEND_API_KEY=
# Optional; defaults to Resend's shared sandbox sender if unset. Set this once
# a sending domain is verified in the Resend dashboard.
RESEND_FROM_ADDRESS=
